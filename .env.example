APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=analisis_teks_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NLP API Service (FastAPI, jalankan `python run.py` di ../nlp-api-service)
NLP_API_URL=http://localhost:8001
# Timeout satu permintaan HTTP ke service NLP, dalam detik.
# HARUS lebih kecil dari ProcessTextAnalysis::$timeout (1800), supaya yang
# menghentikan pekerjaan macet adalah job - yang mencatat sebab kegagalan dan
# mencoba ulang - bukan permintaan HTTP yang menggantung.
# Terukur: 885 teks = 50 detik (sentimen) sampai 235 detik (gabungan).
NLP_API_TIMEOUT=600
NLP_API_BATCH_SIZE=50
# Batas yang ditegakkan service NLP (app/config.py di nlp-api-service).
# Divalidasi lebih dulu di Laravel agar pesan galatnya jelas.
NLP_API_MAX_TEXTS=10000
NLP_API_MAX_TEXT_LENGTH=10000

# YouTube Data API v3 - untuk fitur scraper komentar
YOUTUBE_API_KEY=

# Google Gemini - untuk pelabelan topik otomatis
GEMINI_API_KEY=
# Dipatok versinya, jangan pakai alias -latest: hasil interpretasi harus
# bisa direproduksi saat dikutip di naskah.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=45
GEMINI_RETRY=2

# Ambang keyakinan untuk active learning, dinyatakan sebagai TOLERANSI GALAT.
# Ambang tinjauan = 1 - nilai ini, jadi 0.10 berarti ambang 0,90.
#
# Dasarnya: model sentimen dikalibrasi suhu (T = 2,7748, ECE 0,0209), sehingga
# skor keyakinan adalah taksiran peluang prediksi itu benar. Ambang karena itu
# berarti "tinjau bila perkiraan salahnya di atas 10%" - pernyataan risiko, bukan
# angka yang disetel pada data uji.
#
# Terkonfirmasi tabel reliabilitas model yang sama: di atas 0,90 akurasi 95,4%
# (455 dari 500 sampel), tepat di bawahnya 57,1%. Satu angka ini menentukan
# ambang tinjauan, batas pita sebaran keyakinan, DAN penilaian ringkas.
ANALYSIS_ERROR_TOLERANCE=0.10

# Menimpa perhitungan di atas. Kosongkan dalam keadaan normal - mengisinya
# berarti melepas dasar kalibrasi tadi.
# ANALYSIS_REVIEW_THRESHOLD=

# Pelatihan ulang otomatis. Loop active learning menutup dirinya sendiri:
# begitu koreksi pengguna mencapai ambang, pelatihan ulang diantrekan tanpa
# perlu admin menekan tombol.
#
# Dipicu saat pengguna menyimpan koreksi - tidak butuh cron atau penjadwal.
#
# MIN dihitung dari koreksi SETELAH pelatihan terakhir, bukan total. COOLDOWN
# mencegah beberapa sesi koreksi berdekatan memicu fine-tuning berulang; isi 0
# untuk mematikannya.
# Menyalakannya membuat tombol Kirim pada halaman koreksi langsung menutup
# putaran active learning untuk analisis yang sedang dikoreksi. Yang menjaga
# putaran tetap sah bukan saklar ini, melainkan ambang kelayakan 50 sampel dan
# penolakan "iterasi sebelumnya belum diukur" di RetrainingService::dispatch() -
# keduanya berlaku untuk seluruh jalur, termasuk `php artisan retrain:analysis`.
ANALYSIS_AUTO_RETRAIN=true
# Dinaikkan dari 10. Pada 10 koreksi, set validasi 20%-nya hanya 2-4 baris dan
# keputusan menyimpan checkpoint diambil dari pengukuran yang tidak bermakna -
# terukur pada putaran pertama: val_size 4, delta 0, checkpoint tetap disimpan.
# Pada 50, set validasinya ~10 baris; masih kecil, tetapi tidak lagi tanpa arti.
ANALYSIS_AUTO_RETRAIN_MIN=50
# Jeda dihitung PER ANALISIS, bukan global: studi kasus menjalankan enam
# putaran satu per lembaga, dan jeda global akan menahan lembaga berikutnya
# hanya karena lembaga sebelumnya baru dilatih.
ANALYSIS_AUTO_RETRAIN_COOLDOWN=6

# Cermin `settings.calibration_min_samples` di nlp-api-service. Hanya untuk
# menandai riwayat training: di bawah angka ini layanan mewarisi suhu kalibrasi
# alih-alih mengukurnya ulang, jadi keyakinan pada iterasi itu belum diukur.
ANALYSIS_CALIBRATION_MIN_VAL=50
ANALYSIS_AUTO_RETRAIN_MODEL=both
ANALYSIS_AUTO_RETRAIN_EPOCHS=3

# Evaluasi hold-out (golden dataset). Lihat docs/PANDUAN_EVALUASI.md.
# ANALYSIS_EVAL_SEED: semai bootstrap untuk selang kepercayaan macro-F1.
# Jangan diubah di tengah rangkaian studi kasus; angka di naskah harus bisa
# dihitung ulang dan menghasilkan selang yang sama persis.
ANALYSIS_EVAL_BOOTSTRAP=1000
ANALYSIS_EVAL_SEED=42

# Berapa lama worker menunggu sebelum menganggap job hilang dan melepasnya
# kembali ke antrean. WAJIB LEBIH BESAR dari ProcessTextAnalysis::$timeout
# (3600), atau job yang MASIH BERJALAN diambil worker kedua dan analisis yang
# sama berjalan berkali-kali sekaligus. Nilai bawaan Laravel (90) jauh lebih
# kecil dari durasi analisis nyata, sehingga praktis setiap analisis
# terduplikasi.
#
# Dinaikkan dari 2100 untuk skala studi kasus: analisis gabungan memakan
# sekitar 0,27 detik per teks, jadi 3.548 komentar butuh ~950 detik dan
# 8.393 komentar butuh ~2.230 detik.
DB_QUEUE_RETRY_AFTER=4200
