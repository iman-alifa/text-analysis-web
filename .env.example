APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=analisis_teks_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NLP API Service (FastAPI, jalankan `python run.py` di ../nlp-api-service)
NLP_API_URL=http://localhost:8001
# Timeout satu permintaan HTTP ke service NLP, dalam detik.
# HARUS lebih kecil dari ProcessTextAnalysis::$timeout (1800), supaya yang
# menghentikan pekerjaan macet adalah job - yang mencatat sebab kegagalan dan
# mencoba ulang - bukan permintaan HTTP yang menggantung.
# Terukur: 885 teks = 50 detik (sentimen) sampai 235 detik (gabungan).
NLP_API_TIMEOUT=600
NLP_API_BATCH_SIZE=50
# Batas yang ditegakkan service NLP (app/config.py di nlp-api-service).
# Divalidasi lebih dulu di Laravel agar pesan galatnya jelas.
NLP_API_MAX_TEXTS=10000
NLP_API_MAX_TEXT_LENGTH=10000

# YouTube Data API v3 - untuk fitur scraper komentar
YOUTUBE_API_KEY=

# Google Gemini - untuk pelabelan topik otomatis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Berapa lama worker menunggu sebelum menganggap job hilang dan melepasnya
# kembali ke antrean. WAJIB LEBIH BESAR dari ProcessTextAnalysis::$timeout
# (1800), atau job yang MASIH BERJALAN diambil worker kedua dan analisis yang
# sama berjalan berkali-kali sekaligus. Nilai bawaan Laravel (90) jauh lebih
# kecil dari durasi analisis nyata (95-235 detik), sehingga praktis setiap
# analisis terduplikasi.
DB_QUEUE_RETRY_AFTER=2100
