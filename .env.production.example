# =============================================================================
# Contoh .env untuk PRODUKSI
#
# Salin menjadi `.env` di server, lalu isi setiap nilai yang bertanda <...>.
# Berkas ini hanya memuat kunci yang BERBEDA dari `.env.example` atau yang
# wajib diperiksa ulang sebelum dipasang. Kunci lain yang tidak disebut di sini
# boleh mengikuti `.env.example`.
#
# JANGAN pernah memasukkan berkas .env yang sudah terisi ke dalam Git.
# =============================================================================

APP_NAME="Analisis Teks Otomatis"

# production mematikan halaman galat rinci dan mengaktifkan optimasi framework.
APP_ENV=production

# WAJIB diisi. Jalankan `php artisan key:generate` SEKALI di server, lalu
# simpan hasilnya. Mengganti kunci ini membuat seluruh sesi yang berjalan
# menjadi tidak sah dan pengguna terlempar keluar.
APP_KEY=

# WAJIB false. Bila true, halaman galat menampilkan jejak kode beserta isi
# konfigurasi - termasuk kata sandi basis data - kepada siapa pun yang membuka
# halaman yang error.
APP_DEBUG=false

# Alamat publik aplikasi, lengkap dengan https. Dipakai untuk menyusun tautan
# pada email dan aset, jadi salah isi di sini membuat tautannya menunjuk
# localhost.
APP_URL=https://<domain-anda>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# -----------------------------------------------------------------------------
# Basis data
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nama_database>
DB_USERNAME=<pengguna_database>
DB_PASSWORD=<kata_sandi_database>

# WAJIB lebih besar dari ProcessTextAnalysis::$timeout (3600). Bila lebih kecil,
# job yang MASIH BERJALAN diambil worker kedua dan analisis yang sama berjalan
# berkali-kali sekaligus.
DB_QUEUE_RETRY_AFTER=4200

# Pelatihan ulang berjalan di antrean sendiri ('training') dengan worker kedua,
# supaya analisis pengguna tidak tertahan 41-61 menit di belakangnya.
# retry_after-nya WAJIB lebih besar dari RetrainModel::$timeout (7200).
QUEUE_TRAINING_CONNECTION=training
DB_TRAINING_RETRY_AFTER=7500

# -----------------------------------------------------------------------------
# Sesi & keamanan
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120

# true bila situs sudah memakai HTTPS. Cookie sesi lalu hanya dikirim lewat
# koneksi terenkripsi.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Layanan NLP (nlp-api-service)
# -----------------------------------------------------------------------------
# Alamat layanan Python. Pada rencana satu VPS, layanan mendengar di
# 127.0.0.1 saja dan port 8001 tidak dibuka ke internet.
#   - Server yang sama (dipakai) : http://127.0.0.1:8001
#   - Server terpisah            : https://api.<domain-anda> (tanpa garis miring di akhir)
NLP_API_URL=http://127.0.0.1:8001

# Batas satu permintaan ANALISIS. WAJIB lebih kecil dari
# ProcessTextAnalysis::$timeout (3600), supaya yang menghentikan pekerjaan macet
# adalah job - yang bisa mencatat sebabnya - bukan HTTP yang menggantung.
# (Contoh lama berisi 3600, sama dengan batas job, dan itu keliru.)
NLP_API_TIMEOUT=600

# Batas satu permintaan PEMODELAN TOPIK, yang dikirim utuh (tidak per batch).
# Terukur di VPS produksi: 3.366 komentar = 972 detik. WAJIB < 3600.
NLP_API_TOPIC_TIMEOUT=2400

# Batas satu permintaan PELATIHAN ULANG. Rantai:
#   6600 < RetrainModel::$timeout (7200) < DB_TRAINING_RETRY_AFTER (7500).
# Pelatihan di CPU VPS 4 vCPU diperkirakan 41-61 menit per putaran. Klien yang
# menyerah lebih dulu tidak menghentikan pelatihan di layanan; ia hanya membuat
# riwayat mencatat 'failed' padahal bobot baru sudah hidup.
NLP_API_RETRAIN_TIMEOUT=6600

# WAJIB bila layanan NLP memakai APP_ENV=production: layanan itu menolak
# setiap permintaan analisis tanpa header X-API-Key yang cocok (HTTP 401).
# Nilainya harus SAMA PERSIS dengan API_KEY di /opt/nlp-api-service/.env.
#
# Buat kunci baru untuk produksi, jangan pakai ulang kunci pengembangan:
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# Hasilnya 48 karakter heksadesimal, tanpa tanda hubung di depan dan tanpa
# karakter khusus, jadi aman ditempel ke panel pengaturan mana pun.
#
# `php artisan deploy:check` memeriksa kunci ini terhadap endpoint berkunci.
# /health sengaja terbuka tanpa kunci, jadi layanan yang "hidup" belum tentu
# menerima kuncinya.
NLP_API_KEY=

# -----------------------------------------------------------------------------
# Kunci API pihak ketiga (opsional)
# -----------------------------------------------------------------------------
# Tanpa GEMINI_API_KEY, tombol "Jelaskan dengan AI" mati dan sisa halaman tetap
# utuh. Tanpa YOUTUBE_API_KEY, menu YouTube Scraper tidak bisa mencari video.
GEMINI_API_KEY=
# Model dicoba berurutan; yang pertama berhasil dipakai dan tercatat di
# provenance narasi. Hanya nama yang benar-benar tersedia untuk kunci ini:
# model yang pensiun (1.5, 2.5) membalas 404. `php artisan deploy:check`
# mencoba setiap nama di daftar ini.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash

YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Pelatihan ulang otomatis
# -----------------------------------------------------------------------------
# Biarkan true agar koreksi pengguna benar-benar melatih model. Setel false bila
# bobot model sedang dipakai untuk pengukuran yang belum selesai.
ANALYSIS_AUTO_RETRAIN=true
ANALYSIS_AUTO_RETRAIN_MIN=50

# Jeda global antar putaran, dalam jam. 6 wajar untuk pemakaian normal; 0 hanya
# bila beberapa putaran memang sengaja dijalankan berurutan.
ANALYSIS_AUTO_RETRAIN_COOLDOWN=6

# Evaluasi hold-out otomatis di akhir setiap putaran pelatihan ulang, atas test
# set beku yang sedang dipakai. Tanpa test set beku, langkah ini dilewati dan
# pelatihan berikutnya tidak diblokir.
ANALYSIS_AUTO_EVALUATE=true

# -----------------------------------------------------------------------------
# Log
# -----------------------------------------------------------------------------
# daily menyimpan satu berkas per hari dan membuang yang lama, sehingga log
# tidak tumbuh tanpa batas sampai memenuhi disk.
LOG_CHANNEL=daily
LOG_LEVEL=warning

MAIL_MAILER=log
